# Database
DATABASE_URL="postgresql://user:password@localhost:5432/afrikanium?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# CORS
FRONTEND_URL=http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
